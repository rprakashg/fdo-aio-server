# Modifying this file in-place is not recommended because changes will
# be overwritten during image/package upgrades. Customize via a systemd
# "drop-in" instead, e.g. `systemctl edit fdo-manufacturing.service`:
#
#	[Service]
#	Environment=PORT=8038
#	ExecStart=
#	ExecStart=/usr/bin/go-fdo-server manufacturing 0.0.0.0:${PORT} --log-level debug ...

[Unit]
Description=FDO Manufacturing Server
Documentation=https://github.com/fido-device-onboard/go-fdo-server
After=network.target

[Service]
Type=simple
PrivateDevices=yes
StateDirectory=go-fdo-manufacturing
CacheDirectory=go-fdo-manufacturing
Environment=PORT=8038
# The device CA cert/key must be the same files used by fdo-owner.service,
# and the owner cert must be the same file used by fdo-owner.service's key.
ExecStart=/usr/bin/go-fdo-server manufacturing --config /etc/fdo/config/manufacturing.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
